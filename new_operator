#include <iostream>
using namespace std;

int main() {
    int *p=new int;
    *p=25;
    float *q=new float(2.5);
    
    cout<<"Pointer: "<<p<<'\n';
    cout<<"Value: "<<*p<<'\n'<<endl;
    cout<<"Pointer: "<<q<<'\n';
    cout<<"Value: "<<*q<<'\n'<<endl;
    
    delete p;
    cout<<"Pointer: "<<p<<'\n';
    cout<<"Value: "<<*p<<'\n'<<endl; //will return garbage values
    return 0;
}
