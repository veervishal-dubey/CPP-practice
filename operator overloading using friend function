#include <iostream>
using namespace std;
class Complex{
    private:
        float real;
        float img;
    public:
        Complex(float x=0, float y=0)
        {
            real=x;
            img=y;
        }
        friend Complex operator +(Complex &c1, Complex &c2);
        void display(){
            cout<<real<<"+i "<<img<<"\n"<<endl;
        }

};

Complex operator +(Complex &c1, Complex &c2)
{
    Complex temp;
    temp.real=c2.real+c1.real;
    temp.img=c2.img+c1.img;
    return temp;
}

int main()
{
    Complex t1(10.5,20.100);
    Complex t2(1.2345,2.876);
    Complex t4=t1;
    t1=t1+t2;
    t4.display();
    t1.display();
    return 0;

}
